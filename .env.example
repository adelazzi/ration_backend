# Copy to .env for local development. On Render these are set in render.yaml / the dashboard.
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DATABASE_URL=postgres://user:password@localhost:5432/ration

# Sharing through ngrok (./share.sh). Claim your free fixed domain at
# https://dashboard.ngrok.com/domains so the link stays the same every time.
# NGROK_DOMAIN=flashcard-clubhouse-omission.ngrok-free.dev

# Demo day: show "log in as manager / accountant / creator" buttons on the login page.
# Create the accounts first with: python manage.py create_demo_accounts
# Anyone with the link can use them, so turn this off afterwards.
# DJANGO_DEMO_LOGIN=true
